{
  "hosting": {
    "site": "nova-ia",
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firestore.rules", "prototipo-*", "fotos-*/**", "fotos-*", "**/.*"],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
