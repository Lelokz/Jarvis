<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Sempre ouvindo": o serviço em primeiro plano com o microfone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A ponte do relógio: o serviço que segura o celular acordado enquanto
         a conversa do relógio passa por ele. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- As novidades da escola: a busca de 15 em 15 min volta depois de reiniciar. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14+: tarefa com "só com internet" sem isto derruba o app. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- O app se atualiza sozinho (beta 0.10.0): baixa o APK do PC e entrega ao instalador. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:label="Jarvis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Tema.Jarvis"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Compartilhar com o Jarvis" (beta 0.10.5): foto, vídeo, arquivo ou link
                 de qualquer app vai para a conversa. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".ServicoOuvido"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- O relógio abre o canal "/jarvis": o Google Play services acorda
             este serviço, mesmo com o app fechado. -->
        <service
            android:name=".ServicoRelogio"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/jarvis" />
            </intent-filter>
        </service>
        <receiver
            android:name=".ResultadoDaInstalacao"
            android:exported="false" />
        <service
            android:name=".TarefaNovidades"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".ServicoPonte"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
